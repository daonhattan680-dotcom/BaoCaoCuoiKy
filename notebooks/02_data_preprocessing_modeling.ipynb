   "source": [
    "# Đọc file dữ liệu gốc\n",
    "file_path = '../data/AirQualityUCI.csv'\n",
    "try:\n",
    "    df_raw = pd.read_csv(file_path, sep=';', decimal=',')\n",
    "except:\n",
    "    df_raw = pd.read_csv(file_path)\n",
    "\n",
    "print(f\"Kích thước dữ liệu thô: {df_raw.shape}\")\n",
    "df_raw.head()"
   ]
