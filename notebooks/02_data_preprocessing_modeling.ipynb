     ]
    }
   ],
   "source": [
    "# 1. Loại bỏ các cột hoàn toàn rỗng nếu có\n",
    "df = df_raw.dropna(how='all', axis=1).copy()\n",
    "df = df.dropna(how='all', axis=0)\n",
    "\n",
    "# 2. Xử lý định dạng Thời gian (DateTime)\n",
    "df['Date'] = df['Date'].str.replace('/', '-')\n",
    "df['Time'] = df['Time'].str.replace('.', ':')\n",
    "df['DateTime'] = pd.to_datetime(df['Date'] + ' ' + df['Time'], format='%d-%m-%Y %H:%M:%S', errors='coerce')\n",
    "\n",
    "# Loại bỏ các dòng không tạo được DateTime đúng\n",
    "df = df.dropna(subset=['DateTime']).sort_values('DateTime').reset_index(drop=True)\n",
    "\n",
    "# 3. Thay thế giá trị quy ước -200 thành np.nan\n",
    "df = df.replace(-200, np.nan)\n",
    "\n",
    "# 4. Loại bỏ cột NMHC(GT) do thiếu >90%\n",
    "if 'NMHC(GT)' in df.columns:\n",
    "    df = df.drop(columns=['NMHC(GT)'])\n",
    "\n",
    "# 5. Loại bỏ các dòng thiếu biến mục tiêu 'NO2(GT)'\n",
    "df = df.dropna(subset=['NO2(GT)']).reset_index(drop=True)\n",
    "\n",
    "# 6. Tạo đặc trưng thời gian (Feature Engineering)\n",
    "df['Hour'] = df['DateTime'].dt.hour\n",
    "df['DayOfWeek'] = df['DateTime'].dt.dayofweek\n",
    "df['Month'] = df['DateTime'].dt.month\n",
    "\n",
    "# 7. Điền giá trị thiếu cho các biến đầu vào bằng Interpolation (Linear)\n",
    "feature_cols = [c for c in df.columns if c not in ['Date', 'Time', 'DateTime', 'NO2(GT)']]\n",
    "df[feature_cols] = df[feature_cols].interpolate(method='linear').bfill().ffill()\n",
    "\n",
    "print(f\"Kích thước dữ liệu sau khi tiền xử lý cơ bản: {df.shape}\")\n",
    "print(f\"Số lượng giá trị thiếu còn lại:\\n{df[['NO2(GT)'] + feature_cols].isnull().sum()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9bef9199",
   "metadata": {},
   "source": [
    "2. MÔ TẢ CÁCH CHIA TRAIN/TEST VÀ PHÒNG TRÁNH DATA LEAKAGE\n",
    "\n",
    "- Do đây là dữ liệu chuỗi thời gian (Time-Series Dataset), chúng ta KHÔNG sử dụng \n",
    "  hàm phân chia ngẫu nhiên (Random Train/Test Split) để tránh rò rỉ thông tin tương lai.\n",
    "- Phương pháp chia: Split theo mốc thời gian (Chronological Split).\n",
    "  + Tập Train: 80% dữ liệu đầu tiên (quá khứ).\n",
    "  + Tập Test: 20% dữ liệu cuối cùng (tương lai).\n",
    "- Phòng tránh Data Leakage:\n",
    "  + Mọi quá trình chuẩn hóa dữ liệu (StandardScaler) được tích hợp trong Pipeline \n",
    "    và chỉ được `fit` trên tập Train, sau đó `transform` trên tập Test.\n",
    "  + Khi Cross-Validation, sử dụng TimeSeriesSplit để đảm bảo dữ liệu Validation \n",
    "    luôn nằm sau dữ liệu Training."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "e977e2c3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Kích thước tập Train: (6172, 14), Tập Test: (1543, 14)\n",
      "Thời gian Train từ: 2004-03-10 18:00:00 đến 2005-01-28 10:00:00\n",
      "Thời gian Test từ : 2005-01-28 11:00:00 đến 2005-04-04 14:00:00\n"
     ]
    }
   ],
   "source": [
    "X = df[feature_cols]\n",
    "y = df['NO2(GT)']\n",
    "\n",
    "# Chia tỷ lệ 80% Train, 20% Test theo chuỗi thời gian\n",
    "train_size = int(len(df) * 0.8)\n",
    "\n",
    "X_train, X_test = X.iloc[:train_size], X.iloc[train_size:]\n",
    "y_train, y_test = y.iloc[:train_size], y.iloc[train_size:]\n",
    "\n",
    "print(f\"Kích thước tập Train: {X_train.shape}, Tập Test: {X_test.shape}\")\n",
    "print(f\"Thời gian Train từ: {df['DateTime'].iloc[0]} đến {df['DateTime'].iloc[train_size-1]}\")\n",
    "print(f\"Thời gian Test từ : {df['DateTime'].iloc[train_size]} đến {df['DateTime'].iloc[-1]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "11075ca8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== KẾT QUẢ MÔ HÌNH BASELINE TRÊN TẬP TEST ===\n",
      "             Model       RMSE       MAE  R2 Score\n",
      "0  Baseline (Mean)  66.934941  52.52531 -0.542234\n"
     ]
    }
   ],
   "source": [
    "# Hàm tính toán các chỉ số đánh giá (Metrics)\n",
    "def evaluate_predictions(y_true, y_pred, model_name=\"Model\"):\n",
    "    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "    \n",
    "    results = pd.DataFrame({\n",
    "        'Model': [model_name],\n",
    "        'RMSE': [rmse],\n",
    "        'MAE': [mae],\n",
    "        'R2 Score': [r2]\n",
    "    })\n",
    "    return results\n",
    "\n",
    "# Xây dựng Baseline Model (Dùng trung bình tập train)\n",
    "dummy_baseline = DummyRegressor(strategy='mean')\n",
    "dummy_baseline.fit(X_train, y_train)\n",
    "y_pred_baseline = dummy_baseline.predict(X_test)\n",
    "\n",
    "df_results = evaluate_predictions(y_test, y_pred_baseline, model_name=\"Baseline (Mean)\")\n",
    "print(\"=== KẾT QUẢ MÔ HÌNH BASELINE TRÊN TẬP TEST ===\")\n",
    "print(df_results)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9d24e3ee",
   "metadata": {},
   "source": [
    "3 & 4. HUẤN LUYỆN VÀ TINH CHỈNH THAM SỐ QUA PIPELINE VÀ TIME-SERIES CROSS-Validation\n",
    "\n",
    "Các mô hình lựa chọn:\n",
    "1. Ridge Regression (Tuyến tính có L2 Regularization)\n",
    "2. Random Forest Regressor (Ensemble Trees)\n",
    "3. XGBoost Regressor (Gradient Boosting)\n",
    "\n",
    "Quy trình:\n",
    "- Dùng TimeSeriesSplit(n_splits=5) để Cross-Validation trên tập TRAIN.\n",
    "- Dùng GridSearchCV chọn Hyperparameters tối ưu. Tuyệt đối không chạm vào Test Set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "4bf826b1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Tối ưu hóa Hyperparameters hoàn tất!\n",
      "Tham số tối ưu Ridge: {'ridge__alpha': 100.0}\n",
      "Tham số tối ưu Random Forest: {'rf__max_depth': 20, 'rf__min_samples_split': 2, 'rf__n_estimators': 200}\n",
      "Tham số tối ưu XGBoost: {'xgb__learning_rate': 0.1, 'xgb__max_depth': 6, 'xgb__n_estimators': 100}\n"
     ]
    }
   ],
   "source": [
    "tscv = TimeSeriesSplit(n_splits=5)\n",
    "\n",
    "# 1. Pipeline cho Ridge Regression\n",
    "pipe_ridge = Pipeline([\n",
    "    ('scaler', StandardScaler()),\n",
    "    ('ridge', Ridge())\n",
    "])\n",
    "param_grid_ridge = {'ridge__alpha': [0.1, 1.0, 10.0, 100.0]}\n",
    "\n",
    "grid_ridge = GridSearchCV(pipe_ridge, param_grid_ridge, cv=tscv, scoring='neg_mean_squared_error', n_jobs=-1)\n",
    "grid_ridge.fit(X_train, y_train)\n",
    "\n",
    "# 2. Pipeline cho Random Forest\n",
    "pipe_rf = Pipeline([\n",
    "    ('rf', RandomForestRegressor(random_state=42))\n",
    "])\n",
    "param_grid_rf = {\n",
    "    'rf__n_estimators': [100, 200],\n",
    "    'rf__max_depth': [10, 20, None],\n",
    "    'rf__min_samples_split': [2, 5]\n",
    "}\n",
    "\n",
    "grid_rf = GridSearchCV(pipe_rf, param_grid_rf, cv=tscv, scoring='neg_mean_squared_error', n_jobs=-1)\n",
    "grid_rf.fit(X_train, y_train)\n",
    "\n",
    "# 3. Pipeline cho XGBoost\n",
    "pipe_xgb = Pipeline([\n",
    "    ('xgb', XGBRegressor(random_state=42, objective='reg:squarederror'))\n",
    "])\n",
    "param_grid_xgb = {\n",
    "    'xgb__n_estimators': [100, 200],\n",
    "    'xgb__learning_rate': [0.01, 0.1],\n",
    "    'xgb__max_depth': [3, 6]\n",
    "}\n",
    "\n",
    "grid_xgb = GridSearchCV(pipe_xgb, param_grid_xgb, cv=tscv, scoring='neg_mean_squared_error', n_jobs=-1)\n",
    "grid_xgb.fit(X_train, y_train)\n",
    "\n",
    "print(\"Tối ưu hóa Hyperparameters hoàn tất!\")\n",
    "print(f\"Tham số tối ưu Ridge: {grid_ridge.best_params_}\")\n",
    "print(f\"Tham số tối ưu Random Forest: {grid_rf.best_params_}\")\n",
    "print(f\"Tham số tối ưu XGBoost: {grid_xgb.best_params_}\")"
   ]
